#include <stdio.h>
#include <stdlib.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int maxResult(int* nums, int numsSize, int k) {
    // dp[i] stores the maximum score to reach index i
    int* dp = (int*)malloc(numsSize * sizeof(int));
    dp[0] = nums[0];
    
    // Deque stores the indices of the dp array
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0;
    int tail = 0;
    
    // Initialize deque with the first index
    deque[tail++] = 0;
    
    for (int i = 1; i < numsSize; i++) {
        // Remove indices that are out of the k-step window
        if (deque[head] < i - k) {
            head++;
        }
        
        // The maximum score to reach index i comes from the front of the deque
        dp[i] = nums[i] + dp[deque[head]];
        
        // Maintain decreasing order of dp values in the deque
        while (tail > head && dp[deque[tail - 1]] <= dp[i]) {
            tail--;
        }
        
        // Add current index to the deque
        deque[tail++] = i;
    }
    
    int result = dp[numsSize - 1];
    
    // Free allocated memory
    free(dp);
    free(deque);
    
    return result;
}
