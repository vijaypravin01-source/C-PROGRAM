#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int *arr;
    int front;
    int rear;
    int size;
    int capacity;
} MyCircularQueue;

// Initialize the circular queue with size k
MyCircularQueue* myCircularQueueCreate(int k) {
    MyCircularQueue* obj = (MyCircularQueue*)malloc(sizeof(MyCircularQueue));
    obj->capacity = k;
    obj->arr = (int*)malloc(k * sizeof(int));
    obj->front = -1;
    obj->rear = -1;
    obj->size = 0;
    return obj;
}

// Check whether the circular queue is empty
bool myCircularQueueIsEmpty(MyCircularQueue* obj) {
    return obj->size == 0;
}

// Check whether the circular queue is full
bool myCircularQueueIsFull(MyCircularQueue* obj) {
    return obj->size == obj->capacity;
}

// Insert an element into the circular queue
bool myCircularQueueEnQueue(MyCircularQueue* obj, int value) {
    if (myCircularQueueIsFull(obj)) {
        return false;
    }
    if (myCircularQueueIsEmpty(obj)) {
        obj->front = 0;
    }
    obj->rear = (obj->rear + 1) % obj->capacity;
    obj->arr[obj->rear] = value;
    obj->size++;
    return true;
}

// Delete an element from the circular queue
bool myCircularQueueDeQueue(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return false;
    }
    obj->front = (obj->front + 1) % obj->capacity;
    obj->size--;
    if (myCircularQueueIsEmpty(obj)) {
        obj->front = -1;
        obj->rear = -1;
    }
    return true;
}

// Get the front item from the queue
int myCircularQueueFront(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    return obj->arr[obj->front];
}

// Get the last item from the queue
int myCircularQueueRear(MyCircularQueue* obj) {
    if (myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    return obj->arr[obj->rear];
}

// Free allocated memory
void myCircularQueueFree(MyCircularQueue* obj) {
    free(obj->arr);
    free(obj);
}

// Example usage
int main() {
    MyCircularQueue* q = myCircularQueueCreate(3);
    
    printf("%d\n", myCircularQueueEnQueue(q, 1)); // returns true
    printf("%d\n", myCircularQueueEnQueue(q, 2)); // returns true
    printf("%d\n", myCircularQueueEnQueue(q, 3)); // returns true
    printf("%d\n", myCircularQueueEnQueue(q, 4)); // returns false (full)
    printf("Rear: %d\n", myCircularQueueRear(q)); // returns 3
    printf("Full: %d\n", myCircularQueueIsFull(q)); // returns true
    printf("%d\n", myCircularQueueDeQueue(q)); // returns true
    printf("%d\n", myCircularQueueEnQueue(q, 4)); // returns true
    printf("Rear: %d\n", myCircularQueueRear(q)); // returns 4
    
    myCircularQueueFree(q);
    return 0;
}
