#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    long long total_surplus = 0;
    long long current_surplus = 0;
    int start_index = 0;

    for (int i = 0; i < n; i++) {
        long long petrol, distance;
        scanf("%lld %lld", &petrol, &distance);

        long long diff = petrol - distance;
        total_surplus += diff;
        current_surplus += diff;

        // If the truck runs out of petrol before reaching the next pump
        if (current_surplus < 0) {
            // Pick the next pump as the new candidate starting point
            start_index = i + 1;
            // Reset the current tank surplus balance
            current_surplus = 0;
        }
    }

    // If total accumulated surplus is non-negative, a valid route exists
    if (total_surplus >= 0) {
        printf("%d\n", start_index);
    } else {
        printf("-1\n"); // If no circular journey is possible
    }

    return 0;
}
