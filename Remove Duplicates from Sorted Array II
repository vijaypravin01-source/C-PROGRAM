int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, it is already valid
    if (numsSize <= 2) {
        return numsSize;
    }

    // Initialize the pointer where the next valid element will be written
    int k = 2;

    // Iterate through the array starting from the third element
    for (int i = 2; i < numsSize; i++) {
        // Compare current element with the element 2 positions behind the write pointer
        if (nums[i] != nums[k - 2]) {
            nums[k] = nums[i];
            k++;
        }
    }

    // k represents the length of the valid prefix array
    return k;
}
