#include <queue>

class MyStack {
private:
    std::queue<int> q; // Standard C++ built-in queue

public:
    // Initializes the stack object
    MyStack() {
        // No explicit initialization needed for std::queue
    }
    
    // Pushes element x to the top of the stack
    void push(int x) {
        q.push(x);
        
        // Rotate the queue to force Last-In, First-Out (LIFO) behavior
        int current_size = q.size();
        for (int i = 0; i < current_size - 1; ++i) {
            q.push(q.front());
            q.pop();
        }
    }
    
    // Removes the element on the top of the stack and returns it
    int pop() {
        int top_element = q.front();
        q.pop();
        return top_element;
    }
    
    // Returns the element on the top of the stack
    int top() {
        return q.front();
    }
    
    // Returns true if the stack is empty, false otherwise
    bool empty() {
        return q.empty();
    }
};

