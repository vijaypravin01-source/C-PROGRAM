void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    int p1 = m - 1;        // Pointer for last valid element in nums1
    int p2 = n - 1;        // Pointer for last element in nums2
    int p = m + n - 1;     // Pointer for the last index of nums1 array

    // Move backwards, comparing and placing the larger element
    while (p1 >= 0 && p2 >= 0) {
        if (nums1[p1] > nums2[p2]) {
            nums1[p] = nums1[p1];
            p1--;
        } else {
            nums1[p] = nums2[p2];
            p2--;
        }
        p--;
    }

    // Copy any remaining elements from nums2 if nums1 is exhausted
    while (p2 >= 0) {
        nums1[p] = nums2[p2];
        p2--;
        p--;
    }
}
